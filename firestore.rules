rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 伝票アプリ（既存）
    match /pvdata/{docId} {
      allow read, write: if request.auth != null;
    }

    // 入出荷台帳マスタ（客先・品目）
    match /ledgerMaster/{docId} {
      allow read, write: if request.auth != null;
    }

    // 入出荷台帳（1件ずつ保存・同時利用向け）
    match /ledgerRecords/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /loginLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    // 伝票アプリ（既存コレクション）
    match /pvInvoiceLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    // 台帳→伝票の数量受け渡し（タブレット仮運用でも送れるよう create は認証不要）
    match /ledgerIssuePending/{docId} {
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.keys().hasAll(["client", "deliveryDate", "lotNo", "items", "at", "status", "source"]);
      allow read: if true;
      allow update: if resource.data.status == "pending";
      allow delete: if false;
    }
    match /ledgerIssuePending_demo/{docId} {
      allow create: if request.resource.data.status == "pending"
        && request.resource.data.keys().hasAll(["client", "deliveryDate", "lotNo", "items", "at", "status", "source"]);
      allow read: if true;
      allow update: if resource.data.status == "pending";
      allow delete: if false;
    }

    // 台帳⇔伝票の客先・品目マスタ共有（仮運用でも読めるよう認証不要）
    match /sharedMasters/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(["value", "updatedAt", "updatedBy"]);
    }
  }
}
